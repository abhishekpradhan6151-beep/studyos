# Public configuration, safe for browser bundles. Never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side: exact model ID from the live AI Gateway catalog.
AI_GATEWAY_MODEL=
# Optional for local AI testing. Vercel deployments use OIDC automatically.
AI_GATEWAY_API_KEY=
